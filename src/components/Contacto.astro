---
import { perfil } from '@/data/perfil';

const enlaces = [
  { etiqueta: 'Email', valor: perfil.email, href: `mailto:${perfil.email}` },
  { etiqueta: 'LinkedIn', valor: 'Erick Alejandro Graterol', href: perfil.linkedin },
  { etiqueta: 'GitHub', valor: 'eirikrrrr', href: perfil.github },
];
---

<section id="contacto" class="scroll-mt-20 border-t border-line bg-surface py-20 md:py-28">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow">Contacto</p>
        <h2 class="mt-3 text-3xl font-semibold md:text-4xl">
          ¿Buscas a alguien que automatice vuestra red?
        </h2>
        <p class="mt-5 max-w-lg text-lg text-body">
          Estoy abierto a incorporarme a un equipo. Si encaja lo que hago, escríbeme y
          te respondo.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={`mailto:${perfil.email}`}
            class="rounded-md bg-accent px-6 py-3 font-semibold text-void transition-colors hover:bg-accent-soft"
          >
            Enviar un correo
          </a>
          <a
            href={perfil.cvPdf}
            download
            class="rounded-md border border-line-strong px-6 py-3 font-semibold text-bright transition-colors hover:border-accent hover:text-accent"
          >
            Descargar CV en PDF
          </a>
        </div>
      </div>

      <dl class="divide-y divide-line border-y border-line">
        {
          enlaces.map((e) => (
            <div class="flex flex-wrap items-center justify-between gap-4 py-4">
              <dt class="font-mono text-xs uppercase tracking-[0.14em] text-muted">
                {e.etiqueta}
              </dt>
              <dd>
                <a
                  href={e.href}
                  rel="me noopener"
                  class="text-body transition-colors hover:text-accent"
                >
                  {e.valor}
                </a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
