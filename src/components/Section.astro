---
interface Props {
  id: string;
  etiqueta: string;
  titulo: string;
  intro?: string;
  /** Alterna el fondo para separar visualmente secciones contiguas. */
  fondo?: boolean;
}

const { id, etiqueta, titulo, intro, fondo = false } = Astro.props;
---

<section
  id={id}
  class:list={['scroll-mt-20 border-t border-line py-20 md:py-28', fondo && 'bg-surface']}
>
  <div class="container-page">
    <p class="eyebrow">{etiqueta}</p>
    <h2 class="mt-3 max-w-3xl text-3xl font-semibold md:text-4xl">{titulo}</h2>
    {intro && <p class="mt-4 max-w-2xl text-lg text-muted">{intro}</p>}

    <div class="mt-12">
      <slot />
    </div>
  </div>
</section>
