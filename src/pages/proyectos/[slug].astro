---
import Base from '@/layouts/Base.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { proyectos } from '@/data/proyectos';
import { perfil } from '@/data/perfil';
import { jsonLdProyecto } from '@/lib/jsonld';

export function getStaticPaths() {
  return proyectos.map((proyecto) => ({
    params: { slug: proyecto.slug },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;

const indice = proyectos.findIndex((p) => p.slug === proyecto.slug);
const siguiente = proyectos[(indice + 1) % proyectos.length];
---

<Base
  titulo={`${proyecto.tituloCorto} — ${perfil.nombreCorto}`}
  descripcion={proyecto.descripcion}
  jsonLd={jsonLdProyecto(proyecto)}
>
  <Header />

  <main id="contenido">
    <article>
      <header class="border-b border-line py-16 md:py-20">
        <div class="container-page">
          <nav aria-label="Migas de pan" class="font-mono text-xs text-muted">
            <a href="/" class="transition-colors hover:text-accent">Inicio</a>
            <span aria-hidden="true" class="mx-2">/</span>
            <a href="/#proyectos" class="transition-colors hover:text-accent">Proyectos</a>
          </nav>

          <h1 class="mt-6 max-w-4xl text-3xl font-semibold md:text-5xl">
            {proyecto.titulo}
          </h1>

          <p class="mt-6 max-w-2xl text-lg text-body">{proyecto.gancho}</p>

          <ul class="mt-8 flex flex-wrap gap-2">
            {
              proyecto.tecnologias.map((t) => (
                <li class="rounded border border-line bg-surface px-2.5 py-1 font-mono text-xs text-muted">
                  {t}
                </li>
              ))
            }
          </ul>
        </div>
      </header>

      <div class="container-page grid gap-14 py-16 lg:grid-cols-[minmax(0,42rem)_1fr] lg:gap-20 md:py-20">
        <div class="space-y-12">
          <section>
            <h2 class="eyebrow">El problema</h2>
            <p class="mt-4 text-lg text-body">{proyecto.problema}</p>
          </section>

          <section>
            <h2 class="eyebrow">Qué construí</h2>
            <div class="mt-4 space-y-5 text-lg text-body">
              {proyecto.solucion.map((parrafo) => <p>{parrafo}</p>)}
            </div>
          </section>

          <section>
            <h2 class="eyebrow">Resultado</h2>
            <ul class="mt-4 space-y-3">
              {
                proyecto.resultado.map((r) => (
                  <li class="flex gap-3 text-lg text-body">
                    <span aria-hidden="true" class="mt-3.5 h-px w-3 shrink-0 bg-accent" />
                    <span>{r}</span>
                  </li>
                ))
              }
            </ul>
          </section>
        </div>

        <aside class="lg:sticky lg:top-24 lg:self-start">
          <div class="rounded-lg border border-line bg-surface p-6">
            <p class="font-mono text-4xl font-semibold text-accent">
              {proyecto.metrica.valor}
            </p>
            <p class="mt-1 text-sm text-muted">{proyecto.metrica.etiqueta}</p>

            <hr class="my-6 border-line" />

            <p class="text-sm text-body">
              ¿Te interesa cómo está resuelto por dentro? Puedo entrar en detalle.
            </p>
            <a
              href={`mailto:${perfil.email}`}
              class="mt-4 inline-block rounded-md bg-accent px-5 py-2.5 text-sm font-semibold text-void transition-colors hover:bg-accent-soft"
            >
              Hablemos
            </a>
          </div>
        </aside>
      </div>

      <nav
        aria-label="Siguiente proyecto"
        class="border-t border-line bg-surface py-12"
      >
        <div class="container-page flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.14em] text-muted">
              Siguiente proyecto
            </p>
            <p class="mt-2 text-xl font-semibold text-bright">{siguiente.tituloCorto}</p>
          </div>
          <a
            href={`/proyectos/${siguiente.slug}`}
            class="rounded-md border border-line-strong px-5 py-2.5 font-semibold text-bright transition-colors hover:border-accent hover:text-accent"
          >
            Verlo →
          </a>
        </div>
      </nav>
    </article>
  </main>

  <Footer />
</Base>
